{
  "name": "WraeclastLedger",
  "version": "1.0.79",
  "description": "WraeclastLedger",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./out/main/index.js",
  "author": "gund0lf",
  "homepage": "https://github.com/gund0lf/wraeclastledger_react",
  "repository": {
    "type": "git",
    "url": "https://github.com/gund0lf/wraeclastledger_react"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run && node --test scripts/cargo-query.test.mjs",
    "test:watch": "vitest",
    "game-data:generate": "node scripts/gen-manifest-json.mjs",
    "trade-stats:check": "node scripts/check-tradestats.mjs",
    "wp14:fixtures": "vite-node scripts/gen-wp14-fixtures.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux-helper": "node scripts/build-linux-clipboard-helper.mjs",
    "build:linux": "npm run build:linux-helper && electron-vite build && electron-builder --linux AppImage --x64 --publish never",
    "verify:linux:canary": "node scripts/verify-linux-canary.mjs",
    "verify:linux:release": "node scripts/verify-linux-release.mjs",
    "publish:win": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mantine/core": "^8.3.9",
    "@mantine/hooks": "^8.3.9",
    "@tabler/icons-react": "^3.44.0",
    "electron-updater": "^6.8.3",
    "fflate": "^0.8.2",
    "flexlayout-react": "^0.8.17",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^4.1.10"
  }
}
